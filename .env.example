# Apify API token — https://console.apify.com/settings/integrations
apify_api_key=

# OpenRouter API key — https://openrouter.ai/keys
open_router_apikey=

# --- LLM endpoint override (optional) -------------------------------------------------
# The automated pipeline (score/tailor/research) talks to one OpenAI-compatible
# /chat/completions endpoint. Leave these blank to use the OpenRouter free-tier defaults
# baked into scripts/llm.py (what the Modal cron uses). Override locally to run against
# Ollama instead — no key, no quota, no rate limits — handy for testing without burning
# OpenRouter's daily budget.
#
#   llm_base_url=http://localhost:11434/v1
#   llm_model=qwen2.5:7b
#   llm_api_key=ollama
#   llm_reasoning_effort=
#
llm_base_url=
llm_model=
llm_fallback_model=
llm_api_key=
llm_reasoning_effort=
llm_request_deadline=
llm_max_retries=

# --- Recovery / resume -------------------------------------------------------------
# Each stage mirrors its artifact (raw_jobs/scored_jobs/tailored_jobs) to a
# "pipeline-artifacts" subfolder of google_drive_folder_id, so a local Ollama run can
# resume a failed Modal run instead of starting over. Set artifact_sync=0 to disable
# (pure-local dev with no Google auth still works without it). PIPELINE_DATE targets a
# specific day's artifacts — leave blank for today; set YYYY-MM-DD to recover an
# earlier day whose Modal run failed.
artifact_sync=
PIPELINE_DATE=

# Google Sheet ID for the one master "Job Application Tracker" sheet.
# Local: leave blank — write_sheet.py finds an existing tracker by name in Drive (or
#   creates one the first time) and writes the id back here.
# Modal: set this in the job-apply-agent-secrets Modal secret — the container has no
#   persistent .env, so the lookup would otherwise run every day.
google_sheet_id=

# Google Drive folder ID where tailored resumes + pipeline artifacts get uploaded.
# Create a folder in Drive, copy the ID from its URL: drive.google.com/drive/folders/<ID>
google_drive_folder_id=

# Telegram bot token + chat id for failure alerts. See README.md "Telegram Failure Alerts".
# Optional — the pipeline runs fine without these, it just won't message you on failure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
