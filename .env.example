# Apify API token — https://console.apify.com/settings/integrations
apify_api_key=

# --- LLM providers (score / tailor / research) ---------------------------------------
# FREE ONLY. Do not add OpenRouter credit or a paid model. scripts/llm.py tries the
# providers below in `llm_provider_order`; each is an independent free tier. When one
# 429s / 404s / times out, the next is tried. When all fail, the run fails loudly and
# Telegram fires — recover locally with Ollama (see bottom).
#
#   groq       — https://console.groq.com/keys  (no credit card; no training on your
#                data; commercial use OK; ~30 RPM / ~1K RPD). PRIMARY.
#   openrouter — https://openrouter.ai/keys  (:free models only; no card; burst-throttled)
#   gemini     — https://aistudio.google.com/apikey  (no card; ~10-15 RPM / ~1K RPD.
#                NOTE: Google MAY train on free-tier inputs/outputs — omit to skip.)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional tuning (safe defaults in scripts/llm.py):
llm_provider_order=            # default: groq,openrouter,gemini
llm_request_delay_seconds=     # default: 5 (cloud) / 0 (local) — spacing before each call
llm_max_retries=              # default: 2 attempts per provider before moving on
llm_request_deadline=         # default: 120s hard cap per attempt
llm_groq_model=               # default: llama-3.3-70b-versatile
llm_openrouter_model=         # default: google/gemma-4-26b-a4b-it:free
llm_gemini_model=             # default: gemini-2.5-flash

# --- LOCAL recovery only (Ollama) ---------------------------------------------------
# Set llm_base_url to switch the whole pipeline to a local OpenAI-compatible server.
# This DISABLES the cloud provider chain entirely (no cloud calls, no failover).
# Modal must NEVER set llm_base_url — modal_app.py refuses to run if it's present.
#   llm_base_url=http://localhost:11434/v1
#   llm_model=qwen2.5:7b
#   llm_api_key=ollama
llm_base_url=
llm_model=
llm_api_key=

# --- Recovery / resume -------------------------------------------------------------
# Each stage mirrors its artifact (raw_jobs/scored_jobs/tailored_jobs) to a
# "pipeline-artifacts" subfolder of google_drive_folder_id, so a local Ollama run can
# resume a failed Modal run instead of starting over. Set artifact_sync=0 to disable
# (pure-local dev with no Google auth still works without it). PIPELINE_DATE targets a
# specific day's artifacts — leave blank for today; set YYYY-MM-DD to recover an
# earlier day whose Modal run failed.
artifact_sync=
PIPELINE_DATE=

# Google Sheet ID for the one master "Job Application Tracker" sheet.
# Local: leave blank — write_sheet.py finds an existing tracker by name in Drive (or
#   creates one the first time) and writes the id back here.
# Modal: set this in the job-apply-agent-secrets Modal secret — the container has no
#   persistent .env, so the lookup would otherwise run every day.
google_sheet_id=

# Google Drive folder ID where tailored resumes + pipeline artifacts get uploaded.
# Create a folder in Drive, copy the ID from its URL: drive.google.com/drive/folders/<ID>
google_drive_folder_id=

# Telegram bot token + chat id for failure alerts. See README.md "Telegram Failure Alerts".
# Optional — the pipeline runs fine without these, it just won't message you on failure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
